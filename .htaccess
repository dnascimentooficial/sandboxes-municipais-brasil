# Sandboxes Brasil: https://sandboxbrasil.dnascimento.com.br/
# Hostinger (Apache/LiteSpeed), deploy via Git. api/.htaccess é independente e continua valendo.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Host canônico: dnascimento.com.br/<pasta>/, www. e variantes vão para o subdomínio,
  #    preservando o caminho e a query. Só casa hosts dnascimento.com.br (nada acontece em localhost).
  RewriteCond %{HTTP_HOST} ^(www\.)?dnascimento\.com\.br$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.sandboxbrasil\.dnascimento\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://sandboxbrasil.dnascimento.com.br/$1 [R=301,L]

  # 2) HTTPS forçado (também atrás de proxy/CDN, que informa o esquema em X-Forwarded-Proto).
  RewriteCond %{HTTP_HOST} ^sandboxbrasil\.dnascimento\.com\.br$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://sandboxbrasil.dnascimento.com.br/$1 [R=301,L]

  # 3) Pastas e arquivos que nunca devem sair pela web. data/sandboxes/ (pasta) é bloqueada;
  #    data/sandboxes.js, data/temas.json e data/orgaos.json seguem públicos.
  RewriteRule ^(rotina|scripts|docs|\.github|\.git|\.superpowers|\.claude|data/sandboxes)(/|$) - [F,L,NC]

  # 4) Política de cache por pasta (a variável é lida pelos "Header ... env=" abaixo).
  #    Imutável só onde a URL muda quando o conteúdo muda (?v= ou arquivos de imagem nomeados).
  RewriteRule ^img/ - [E=SB_CACHE_LONGO:1]
  RewriteRule ^assets/hero/ - [E=SB_CACHE_LONGO:1]
  #    Revalidar sempre (ETag): módulos ES são importados sem versão e os dados mudam no deploy.
  RewriteRule ^assets/js/ - [E=SB_CACHE_REVALIDAR:1]
  RewriteRule ^data/ - [E=SB_CACHE_REVALIDAR:1]
</IfModule>

# Arquivos soltos na raiz que não são conteúdo do site.
<FilesMatch "(^package(-lock)?\.json$|\.md$|^\.gitignore$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=SB_CACHE_LONGO
  Header set Cache-Control "no-cache" env=SB_CACHE_REVALIDAR

  # Arquivos individuais (vêm depois: prevalecem sobre as regras por pasta).
  # app.css e brasil-mapa.js são referenciados com ?v= carimbado, então podem ser imutáveis.
  <FilesMatch "^(app\.css|brasil-mapa\.js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
